{
  "rules": {
    ".read": false,
    ".write": false,

    "games": {
      ".read": true,
      ".indexOn": ["createdAt"],

      "$room": {
        ".read": true,

        ".write": "auth != null && !data.exists()",

        "hostUid": {
          ".validate": "newData.isString() && (data.exists() ? data.val() === newData.val() : newData.val() === auth.uid)"
        },
        "hostId": {
          ".validate": "newData.isString() && (!data.exists() || data.val() === newData.val())"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())"
        },
        "phase": {
          ".write": "auth != null",
          ".validate": "newData.isString() && newData.val().length <= 32"
        },

        "players": {
          ".write": "auth != null && auth.uid === root.child('games').child($room).child('hostUid').val()",
          "$pid": {
            ".write": "auth != null && (!data.exists() || data.child('ownerUid').val() === auth.uid)",
            "ownerUid": {
              ".validate": "newData.val() === auth.uid || auth.uid === root.child('games').child($room).child('hostUid').val()"
            },
            "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "avatar": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "chips": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999" }
          }
        },

        "currentTurn": {
          ".write": "auth != null",
          "bids": {
            "$pid": {
              "amount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999" }
            }
          }
        },

        "$other": {
          ".write": "auth != null"
        }
      }
    }
  }
}
